generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Visibility {
  ALL_MEMBERS
  COLLABORATORS
  ALLOWLIST
}

enum Policy {
  GITHUB
  ALLOWLIST
  ALL_MEMBERS
}

enum GithubRole {
  ADMIN
  MAINTAIN
  WRITE
  TRIAGE
  READ
  NONE
}

enum ParticipationMode {
  AUTO
  APPROVAL
}

enum ActorType {
  USER
  AGENT
  SYSTEM
  GITHUB
}

enum Model {
  SONNET
  OPUS
}

enum TaskSize {
  S
  M
  L
}

/// BLOCKED is derived (TODO with unfinished dependencies) and shown by the API, never stored.
enum TaskStatus {
  PROPOSED
  TODO
  BLOCKED
  IN_PROGRESS
  IN_REVIEW
  DONE
  /// Issue closed (or creator cancelled) before the task started. Hidden from the Backlog.
  CANCELLED
}

/// How the dispatcher picks who gets a task (M4).
enum DispatchMode {
  POOL
  MEMBERS
  BROADCAST
}

enum TemplateScope {
  PERSONAL
  PROJECT
}

enum TemplateDependenciesMode {
  NONE
  ASK
}

enum TaskOrigin {
  PLATFORM
  LABEL_IMPORT
  MCP
}

enum AssignmentKind {
  AUTO_OFFER
  CONSENT_REQUEST
  CLAIM
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  RUNNING
  PUSHED
  SUCCEEDED
  FAILED
  LOST
}

enum ExecMode {
  AUTO
  MANUAL
}

model User {
  id                String    @id @default(cuid())
  githubId          BigInt    @unique
  login             String    @unique
  name              String?
  avatarUrl         String?
  ghAccessTokenEnc  Bytes? // user-to-server token, AES-256-GCM encrypted
  ghRefreshTokenEnc Bytes?
  ghTokenExpiresAt  DateTime?
  paused            Boolean   @default(false)
  maxConcurrent     Int       @default(1)
  maxPendingTasks   Int       @default(20)
  lastLoginAt       DateTime?
  onboardingCompletedAt DateTime?
  onboardingDismissedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions         Session[]
  participations   Participation[]
  permissions      ProjectPermission[]
  addedProjects    Project[]           @relation("ProjectAddedBy")
  agents           Agent[]
  enrollmentTokens EnrollmentToken[]
  createdTasks     Task[]              @relation("TaskCreator")
  templates        TaskTemplate[]
  taskTargets      TaskTarget[]
  assignedTasks    Task[]              @relation("TaskAssignee")
  assignments      Assignment[]
  personalTokens   PersonalToken[]
  oauthGrants      OAuthGrant[]
  oauthCodes       OAuthCode[]
  notifications    Notification[]
  notificationSettings NotificationSettings?
  pushSubscriptions PushSubscription[]
  notificationJobs NotificationJob[]
}

model Session {
  id        String   @id // sha256 of the cookie value
  userId    String
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Installation {
  id                   String    @id @default(cuid())
  githubInstallationId BigInt    @unique
  accountLogin         String
  accountType          String
  suspendedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  projects Project[]
}

model Project {
  id                         String     @id @default(cuid())
  githubRepoId               BigInt     @unique
  fullName                   String     @unique // "owner/repo"
  installationId             String
  defaultBranch              String
  isPrivate                  Boolean
  visibility                 Visibility @default(COLLABORATORS)
  participationPolicy        Policy     @default(GITHUB)
  submissionPolicy           Policy     @default(GITHUB)
  poolLabel                  String     @default("pool")
  requireParticipantApproval Boolean    @default(true)
  sizeBudgets                Json?
  addedById                  String
  archivedAt                 DateTime?
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt

  installation   Installation        @relation(fields: [installationId], references: [id])
  addedBy        User                @relation("ProjectAddedBy", fields: [addedById], references: [id])
  permissions    ProjectPermission[]
  participations Participation[]
  tasks          Task[]
  templates      TaskTemplate[]

  @@index([installationId])
}

model ProjectPermission {
  id             String     @id @default(cuid())
  projectId      String
  userId         String
  githubRole     GithubRole
  canSubmit      Boolean? // null = derive from githubRole; set only by the project owner
  canParticipate Boolean?
  syncedAt       DateTime
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Participation {
  id            String            @id @default(cuid())
  userId        String
  projectId     String
  active        Boolean           @default(false)
  approvedAt    DateTime? // set by an owner when approval is required; null = pending
  rejectedAt    DateTime? // set when an owner rejects the request; cleared when the member asks again
  rejectionReason String? // optional owner note on the latest rejection, shown to the member
  lastRejectedAt  DateTime? // latest rejection; kept on re-application so the owner sees the history
  percent       Int // 0..100; the app enforces sum(active) <= 100 per user
  mode          ParticipationMode
  allowedModels Model[]           @default([SONNET, OPUS])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId, active])
}

/// Append-only: a DB trigger rejects UPDATE and DELETE. Never holds secrets.
model AuditLog {
  id           BigInt    @id @default(autoincrement())
  at           DateTime  @default(now())
  actorType    ActorType
  actorUserId  String?
  action       String
  projectId    String?
  targetUserId String?
  actorAgentId String?
  agentId      String?
  taskId       String?
  ip           String?
  data         Json      @default("{}")

  @@index([projectId, at])
  @@index([actorUserId, at])
  @@index([agentId, at])
  @@index([taskId])
}

/// One per member machine. Only the SHA-256 of the credential secret is stored.
model Agent {
  id           String    @id // agt_<base64url>
  userId       String
  name         String // machine name
  hostname     String?
  os           String?
  arch         String?
  agentVersion String?
  secretHash   String // sha256 hex of the secret
  secretPrefix String // first 6 chars of the secret, for display
  lastSeenAt   DateTime?
  lastUsageAt  DateTime?
  claudeTokenPresent Boolean? // null = never reported
  // False after a run failed on Claude authentication (401, expired login): no auto offers until
  // the agent reports a fresh login (claudeAuthValid true) or a run succeeds.
  claudeAuthValid     Boolean   @default(true)
  claudeAuthInvalidAt DateTime?
  // Last real `claude -p` check reported by the agent (`claude.auth`, v0.5.2) and its error class
  // (unauthorized, no_token, rate_limited, timeout, network, error; null when the check passed).
  claudeAuthCheckedAt DateTime?
  claudeAuthError     String?
  paused       Boolean   @default(false)
  pausedAt     DateTime?
  pauseSource  String? // "web" | "agent"
  revokedAt    DateTime?
  // Last one-click / local update (status: pending|deferred|pulling|restarting|failed|done).
  updateId            String?
  updateStatus        String?
  updateTargetVersion String?
  updateCode          String?
  updateDetail        String?
  updateRequestedAt   DateTime?
  updateUpdatedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageReports  UsageReport[]
  seen          AgentMessageSeen[]
  assignedTasks Task[]
  assignments   Assignment[]
  connection    AgentConnection?

  @@index([userId])
}

/// One-time enrollment token (15 min). Only the SHA-256 is stored.
model EnrollmentToken {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  expiresAt     DateTime
  usedAt        DateTime?
  usedByAgentId String?
  createdIp     String?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

/// Usage figures reported by agents. All ESTIMATES. Retention: 30 days.
model UsageReport {
  id               String    @id @default(cuid())
  agentId          String
  userId           String
  reportedAt       DateTime
  windowStart      DateTime?
  windowResetAt    DateTime?
  inputTokens      BigInt
  outputTokens     BigInt
  cacheWriteTokens BigInt
  cacheReadTokens  BigInt
  weightedTokens   BigInt
  byProject        Json
  byModel          Json
  capacityEstimate BigInt?
  rateLimitedUntil DateTime?
  source           String

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, reportedAt(sort: Desc)])
  @@index([userId, reportedAt(sort: Desc)])
  @@index([reportedAt])
}

/// Dedupe window for acked agent messages. Purged after 24 h.
model AgentMessageSeen {
  agentId   String
  messageId String
  seenAt    DateTime @default(now())
  /// Ack sent for the first delivery, replayed on duplicates. Null while it is processed.
  ack       Json?

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([agentId, messageId])
  @@index([seenAt])
}

/// A unit of work backed by a GitHub issue. The prompt is `bodySnapshot`, never the live issue.
model Task {
  id                 String       @id @default(cuid())
  projectId          String
  githubIssueNumber  Int
  githubIssueNodeId  String
  title              String
  bodySnapshot       String
  bodyHash           String
  acceptanceCriteria String[]
  size               TaskSize     @default(M)
  model              Model        @default(SONNET)
  baseBranch         String
  integrationBranch  String? // PR base = integrationBranch ?? baseBranch
  branchName         String? // orch/issue-<n>-<slug>
  status             TaskStatus   @default(TODO)
  origin             TaskOrigin   @default(PLATFORM)
  createdById        String
  assigneeId         String?
  assigneeAgentId    String?
  prNumber           Int?
  prUrl              String?
  headSha            String?
  dispatchMode       DispatchMode @default(POOL)
  /// Retry (owner or creator): failures before this time are ignored by the dispatcher.
  retryResetAt         DateTime?
  /// Set after repeated `env` failures (repository setup): not dispatched until a retry.
  needsAttention       Boolean      @default(false)
  needsAttentionReason String?
  needsAttentionAt     DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy     User             @relation("TaskCreator", fields: [createdById], references: [id])
  assignee      User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeAgent Agent?           @relation(fields: [assigneeAgentId], references: [id], onDelete: SetNull)
  dependsOn     TaskDependency[] @relation("TaskDeps")
  dependents    TaskDependency[] @relation("TaskDependents")
  assignments   Assignment[]
  targets       TaskTarget[]

  @@unique([projectId, githubIssueNumber])
  @@index([projectId, status])
  @@index([createdById, status])
  /// Dispatcher tick: every TODO task, oldest first.
  @@index([status, createdAt])
  /// History: stable keyset pagination, newest first.
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

/// Acyclic: checked before insert.
model TaskDependency {
  taskId      String
  dependsOnId String

  task      Task @relation("TaskDeps", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("TaskDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
  @@index([dependsOnId])
}

/// Members a MEMBERS-dispatched task may be offered to.
model TaskTarget {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

/// GitHub webhook deliveries already processed (X-GitHub-Delivery dedupe).
model WebhookDelivery {
  deliveryId  String    @id
  event       String
  /// sha256 of the raw body: a replay under a fresh delivery id is still caught.
  bodyHash    String?   @unique
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([receivedAt])
}

/// One claim / offer and its execution. Raw SQL in the migration adds the partial unique index
/// `one_live_assignment`: at most one ACCEPTED/RUNNING/PUSHED assignment per task.
model Assignment {
  id             String           @id @default(cuid())
  taskId         String
  userId         String
  agentId        String?
  kind           AssignmentKind
  status         AssignmentStatus
  execMode       ExecMode?
  reason         String?
  /// FAILED runs: env | claude_auth | rate_limited | timeout | task (see @orch/shared classifyFailure).
  failureClass   String?
  offeredAt      DateTime         @default(now())
  /// PENDING offers and consent requests expire at this time.
  expiresAt      DateTime?
  respondedAt    DateTime?
  /// Accepted auto executions must finish before this time (S/M/L timeouts).
  leaseExpiresAt DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  lastSeq        Int              @default(0)
  usageWeighted  BigInt?
  /// Set when the agent must delete the clone (merge, PR closed, cancel); cleared on its ack.
  cleanupPending Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  task  Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([taskId, status])
  @@index([userId, status])
  @@index([agentId, status])
  @@index([status, expiresAt])
  /// Dispatcher: a member's latest answered assignment, per member per task on every tick.
  @@index([userId, respondedAt])
  /// Dispatcher: usage of the latest SUCCEEDED runs (estimateFor).
  @@index([status, finishedAt])
}

/// M5 personal access token (`orch_pat_<...>`) for the MCP endpoint. Only the SHA-256 is stored.
model PersonalToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  tokenHash  String    @unique // sha256 hex of the whole token
  prefix     String // first characters, for display
  scopes     String[]  @default(["mcp"])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// MCP OAuth client from dynamic client registration (RFC 7591). Public clients only (PKCE, no
/// secret). The client_id is stored hashed (SHA-256), like every other credential.
model OAuthClient {
  id           String   @id @default(cuid())
  clientIdHash String   @unique // sha256 hex of the client_id
  name         String
  redirectUris String[]
  createdAt    DateTime @default(now())

  grants OAuthGrant[]
  codes  OAuthCode[]
}

/// Single-use authorization code (about 60 s). Only the SHA-256 is stored.
model OAuthCode {
  codeHash      String    @id // sha256 hex of the code
  clientId      String
  userId        String
  redirectUri   String
  codeChallenge String // PKCE S256
  resource      String // audience the tokens are bound to
  scope         String
  expiresAt     DateTime
  usedAt        DateTime?
  /// The grant created by exchanging this code: revoked if the code is presented again.
  grantId       String?
  createdAt     DateTime  @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// One user approval of one client: the family of its access and refresh tokens. Revoking it
/// (by the user, by refresh token reuse or by removal from the allowlist) kills every token.
model OAuthGrant {
  id         String    @id @default(cuid())
  userId     String
  clientId   String
  resource   String
  scope      String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  client OAuthClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokens OAuthToken[]

  @@index([userId])
}

enum OAuthTokenKind {
  ACCESS
  REFRESH
}

/// Access (`orch_oat_`, about 1 h) and refresh (`orch_ort_`, rotated on use) tokens. Only the
/// SHA-256 is stored. A refresh token with usedAt set that is presented again revokes the grant.
model OAuthToken {
  tokenHash String         @id // sha256 hex of the token
  grantId   String
  kind      OAuthTokenKind
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  grant OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
  @@index([expiresAt])
}

enum AccessGrantStatus {
  PENDING
  APPROVED
  DENIED
}

/// Sign-in access decided by an admin from the web UI (on top of the env allowlist). Never
/// deleted: removing someone sets DENIED, so their sessions and tokens are refused, not destroyed.
model AccessGrant {
  id           String            @id @default(cuid())
  githubLogin  String            @unique // lower-cased
  githubUserId BigInt?
  avatarUrl    String?
  status       AccessGrantStatus
  note         String? // message from the requester
  requestedAt  DateTime?
  decidedAt    DateTime?
  decidedBy    String? // admin login, or `invite:<id>`
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status])
}

/// Invite link that auto-approves whoever signs in with it. Only the SHA-256 is stored.
model AccessInvite {
  id         String    @id @default(cuid())
  tokenHash  String    @unique // sha256 hex of the token
  multiUse   Boolean   @default(false)
  expiresAt  DateTime
  uses       Int       @default(0)
  revokedAt  DateTime?
  createdBy  String // admin login
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

/// Reusable task skeleton with `{{placeholders}}`. PERSONAL: visible to its creator only. PROJECT:
/// shared with the project (managed by its owner). Built-in templates live in code, not here.
model TaskTemplate {
  id                 String                   @id @default(cuid())
  scope              TemplateScope
  projectId          String?
  createdById        String
  name               String
  description        String                   @default("")
  titleTemplate      String                   @default("")
  bodyTemplate       String
  acceptanceCriteria String[]
  size               TaskSize                 @default(M)
  model              Model                    @default(SONNET)
  labels             String[]
  dependenciesMode   TemplateDependenciesMode @default(NONE)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById, scope])
  @@index([projectId])
}

/// One in-app notification (see apps/server/src/notifications).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  /// NotificationEvent of @orch/shared (task_done, task_failed, ...).
  event     String
  title     String
  body      String
  /// App path (`/backlog`) or absolute URL (a PR).
  url       String?
  projectId String?
  taskId    String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  /// Retention purge.
  @@index([createdAt])
}

/// Per-user notification channels and preferences. Webhook URLs are secrets: AES-256-GCM encrypted.
model NotificationSettings {
  userId        String   @id
  slackUrlEnc   Bytes?
  slackHint     String?
  discordUrlEnc Bytes?
  discordHint   String?
  webhookUrlEnc Bytes?
  webhookHint   String?
  /// Target address; only used once `emailVerifiedAt` is set.
  email         String?
  emailVerifiedAt DateTime?
  /// sha256 (hex) of the single-use confirmation token; the token itself is never stored.
  emailTokenHash String?
  emailTokenExpiresAt DateTime?
  /// Times confirmation e-mails were sent (last 24 h), for the 3/hour and 10/day limits.
  emailSendLog  DateTime[]
  /// { [event]: channel[] }; events missing here use the defaults.
  preferences   Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A browser registered for Web Push (one row per browser). The endpoint is a capability URL of the
/// browser vendor's push service: it is only ever used to deliver that user's notifications.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Multi-instance (see docs/installation.md "Running several server instances") ----------

/// A running server process. Each instance refreshes `heartbeatAt` every ORCH_INSTANCE_HEARTBEAT_MS;
/// one silent for 3 heartbeats is considered gone (its agent connections are ignored, then purged).
model ServerInstance {
  id          String   @id // ORCH_INSTANCE_ID (default: hostname)
  /// ORCH_CLUSTER_NAME: instances only cooperate with the ones of the same cluster.
  cluster     String   @default("orch")
  version     String?
  startedAt   DateTime @default(now()) @db.Timestamptz(3)
  heartbeatAt DateTime @default(now()) @db.Timestamptz(3)

  connections AgentConnection[]

  @@index([cluster, heartbeatAt])
}

/// Which instance holds an agent's live WebSocket (one row per helloed agent). Lets every instance
/// know who is online and where to route a message for that agent.
model AgentConnection {
  agentId       String   @id
  userId        String
  instanceId    String
  maxConcurrent Int      @default(1)
  selfUpdate    Boolean  @default(false)
  agentVersion  String?
  connectedAt   DateTime @db.Timestamptz(3)

  agent    Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  instance ServerInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
}

/// Body of a cross-instance message too large for a NOTIFY payload (8000 bytes): the
/// notification carries this row's id. Deleted after a few minutes.
model ClusterMessage {
  id        String   @id @default(cuid())
  payload   String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
}

/// Fixed-window counter shared by every instance (abuse-sensitive rate limits only).
model RateLimitBucket {
  key       String   @id
  count     Int
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

enum NotificationJobStatus {
  PENDING
  SENDING
  FAILED
}

/// One external notification delivery (Slack, Discord, webhook, e-mail, push), durable across
/// restarts. Workers claim due rows with FOR UPDATE SKIP LOCKED; a delivered job is deleted.
model NotificationJob {
  id            String                @id @default(cuid())
  userId        String
  /// ExternalChannel: slack | discord | webhook | email | push.
  channel       String
  /// Push only: the subscription endpoint. Other targets are read from NotificationSettings at
  /// send time (webhook URLs stay encrypted at rest, never copied here).
  endpoint      String?
  /// OutgoingNotification (title, body, links...): no secrets.
  payload       Json
  status        NotificationJobStatus @default(PENDING)
  attempts      Int                   @default(0)
  nextAttemptAt DateTime              @default(now()) @db.Timestamptz(3)
  /// A SENDING job whose lock expired (its instance died mid-send) is claimed again.
  lockedUntil   DateTime?             @db.Timestamptz(3)
  /// Instance that queued it: it delivers first, the others take over after a grace period.
  instanceId    String?
  lastError     String?
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([instanceId, status])
}
