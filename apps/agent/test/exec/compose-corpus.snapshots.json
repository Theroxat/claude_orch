  "app built from the repo Dockerfile with depends_on, networks, profiles and x- anchors": {
    "model": {
      "name": "orch-task-corpus",
      "networks": {
        "back": {
          "name": "orch-task-corpus_back",
          "ipam": {}
        }
      },
      "services": {
        "app": {
          "restart": "on-failure",
          "cap_add": ["NET_BIND_SERVICE"],
          "cap_drop": ["ALL"],
          "cpus": 1.5,
          "command": null,
          "dns": ["1.1.1.1"],
          "entrypoint": null,
          "environment": {
            "DATABASE_URL": "postgres://app:secret@db:5432/app"
          },
          "extra_hosts": ["api.local=10.0.0.5"],
          "image": "ghcr.io/acme/app:dev",
          "init": true,
          "logging": {
            "driver": "json-file",
            "options": {
              "max-size": "50m"
            }
          },
          "mem_limit": "1073741824",
          "networks": {
            "back": null
          },
          "pids_limit": 512,
          "read_only": true,
          "security_opt": ["no-new-privileges:true"],
          "stop_grace_period": "10s",
          "tmpfs": ["/tmp"],
          "user": "1000:1000",
          "volumes": [
            {
              "type": "bind",
              "source": "@ROOT@",
              "target": "/app",
              "bind": {}
            }
          ],
          "build": {
            "context": "@ROOT@",
            "dockerfile": "docker/Dockerfile",
            "args": {
              "NODE_ENV": "development"
            },
            "target": "dev"
          },
          "depends_on": {
            "db": {
              "condition": "service_healthy",
              "required": true
            }
          }
        },
        "db": {
          "restart": "on-failure",
          "command": null,
          "entrypoint": null,
          "environment": {
            "POSTGRES_PASSWORD": "secret"
          },
          "image": "postgres:17",
          "logging": {
            "driver": "json-file",
            "options": {
              "max-size": "50m"
            }
          },
          "networks": {
            "back": null
          },
          "healthcheck": {
            "test": ["CMD-SHELL", "pg_isready"],
            "interval": "2s"
          }
        }
      },
      "x-common": {
        "logging": {
          "driver": "json-file",
          "options": {
            "max-size": "50m"
          }
        },
        "restart": "on-failure"
      }
    }
  },
