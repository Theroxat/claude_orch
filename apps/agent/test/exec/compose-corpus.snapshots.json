{
  "postgres with healthcheck and named volume": {
    "model": {
      "name": "orch-task-corpus",
      "networks": {
        "default": {
          "name": "orch-task-corpus_default",
          "ipam": {}
        }
      },
      "services": {
        "db": {
          "restart": "unless-stopped",
          "command": null,
          "entrypoint": null,
          "environment": {
            "POSTGRES_DB": "app",
            "POSTGRES_PASSWORD": "secret",
            "POSTGRES_USER": "app"
          },
          "image": "postgres:17",
          "networks": {
            "default": null
          },
          "shm_size": "268435456",
          "volumes": [
            {
              "type": "volume",
              "source": "pgdata",
              "target": "/var/lib/postgresql/data",
              "volume": {}
            },
            {
              "type": "bind",
              "source": "@ROOT@/db/init.sql",
              "target": "/docker-entrypoint-initdb.d/init.sql",
              "read_only": true,
              "bind": {}
            }
          ],
          "healthcheck": {
            "test": ["CMD-SHELL", "pg_isready -U app -d app"],
            "timeout": "5s",
            "interval": "5s",
            "retries": 10
          },
          "ports": [
            {
              "mode": "ingress",
              "target": 5432,
              "published": "5432",
              "protocol": "tcp"
            }
          ]
        }
      },
      "volumes": {
        "pgdata": {
          "name": "orch-task-corpus_pgdata"
        }
      }
    }
  },
  "redis with command, sysctl and tmpfs": {
    "model": {
      "name": "orch-task-corpus",
      "networks": {
        "default": {
          "name": "orch-task-corpus_default",
          "ipam": {}
        }
      },
      "services": {
        "cache": {
          "command": ["redis-server", "--appendonly", "yes"],
          "entrypoint": null,
          "image": "redis:8-alpine",
          "networks": {
            "default": null
          },
          "sysctls": {
            "net.core.somaxconn": "1024"
          },
          "tmpfs": ["/tmp:size=64m,mode=1777"],
          "volumes": [
            {
              "type": "volume",
              "source": "redis",
              "target": "/data",
              "volume": {}
            }
          ],
          "healthcheck": {
            "test": ["CMD", "redis-cli", "ping"],
            "interval": "2s"
          }
        }
      },
      "volumes": {
        "redis": {
          "name": "orch-task-corpus_redis"
        }
      }
    }
  },
  "mysql with ulimits, cap_add SYS_NICE (dropped) and env_file": {
    "model": {
      "name": "orch-task-corpus",
      "networks": {
        "default": {
          "name": "orch-task-corpus_default",
          "ipam": {}
        }
      },
      "services": {
        "mysql": {
          "container_name": "myapp-mysql",
          "cap_add": ["SYS_NICE"],
          "command": null,
          "entrypoint": null,
          "environment": {
            "MYSQL_DATABASE": "app",
            "MYSQL_ROOT_PASSWORD": "root"
          },
          "image": "mysql:8.4",
          "networks": {
            "default": null
          },
          "ulimits": {
            "nofile": {
              "soft": 65536,
              "hard": 65536
            }
          },
          "volumes": [
            {
              "type": "volume",
              "source": "mysql",
              "target": "/var/lib/mysql",
              "volume": {}
            }
          ],
          "healthcheck": {
            "test": ["CMD", "mysqladmin", "ping", "-h", "localhost"],
            "interval": "5s",
            "retries": 20
          },
          "ports": [
            {
              "mode": "ingress",
              "host_ip": "127.0.0.1",
              "target": 3306,
              "published": "3306",
              "protocol": "tcp"
            }
          ]
        }
      },
      "volumes": {
        "mysql": {
          "name": "orch-task-corpus_mysql"
        }
      }
    }
  },
  "minio with console and mc healthcheck": {
    "model": {
      "name": "orch-task-corpus",
