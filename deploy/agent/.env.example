# Written by install.sh to ~/orch/.env (mode 600). Never commit a real .env.
ORCH_SERVER_URL=https://orch.example.com
ORCH_AGENT_ID=
# Durable agent credential obtained by install.sh from the one-time enrollment token.
ORCH_AGENT_CREDENTIAL=
ORCH_WORK_DIR=/home/you/orch/work
ORCH_CLAUDE_DIR=/home/you/.claude
# Your Claude plan, used for the usage estimate: pro | max5 | max20
ORCH_PLAN=pro
# ORCH_AGENT_IMAGE=ghcr.io/theroxat/orch-agent
# ORCH_AGENT_TAG=latest
