# orch production settings. Copy to .env next to compose.yaml. Never commit .env.
# Placeholders only: generate real values as shown.

# --- Public address ---------------------------------------------------------------------
# DNS A/AAAA record of this name must point at this host. Caddy gets the certificate itself.
ORCH_DOMAIN=orch.selfhostr.io
# Host ports for Caddy. ACME HTTP/TLS challenges need 80 and 443 (or an upstream proxy).
HTTP_PORT=80
HTTPS_PORT=443
# Public base URL used for GitHub redirects and install commands. Default: https://$ORCH_DOMAIN
# Only set it if you serve orch on a non-standard port or behind another proxy.
# ORCH_BASE_URL=

# --- Behind Cloudflare Tunnel (instead of ACME) -----------------------------------------
# Cloudflare terminates TLS; cloudflared forwards plain HTTP to a local port. Uncomment this
# whole block and comment out HTTP_PORT/HTTPS_PORT above. See README: Behind Cloudflare Tunnel.
# acme (default): Caddy gets a certificate and owns 80/443. tunnel: plain HTTP only.
# ORCH_TLS_MODE=tunnel
# HTTP_PORT=8495
# Address the HTTP port is bound to. 127.0.0.1 keeps it off the LAN. Use 0.0.0.0 only when
# cloudflared runs in another container or on another host (and firewall the port).
# ORCH_BIND_ADDR=127.0.0.1
# Nothing serves 443 in tunnel mode; this maps it to a random loopback port.
# HTTPS_PUBLISH=127.0.0.1:
# Public URL, always https. Used for the GitHub OAuth callback, install.sh, install and MCP
# commands, and the Secure session cookie.
# ORCH_PUBLIC_URL=https://orch.selfhostr.io
# Peers allowed to set X-Forwarded-* headers (default: private networks, i.e. Caddy).
# ORCH_TRUST_PROXY=loopback,linklocal,uniquelocal

# --- Images -----------------------------------------------------------------------------
# Tag of ghcr.io/theroxat/orch-server and orch-web (latest, or a release such as 0.1.0).
ORCH_VERSION=latest

# --- Database (internal only, never published) ------------------------------------------
POSTGRES_USER=orch
POSTGRES_DB=orch
# openssl rand -hex 24   (hex keeps the DATABASE_URL free of special characters)
POSTGRES_PASSWORD=

# --- Secrets ----------------------------------------------------------------------------
# openssl rand -base64 32   (encrypts GitHub user tokens; losing it logs everyone out)
ORCH_ENCRYPTION_KEY=

# --- Who may sign in (REQUIRED in production) ----------------------------------------------
# Comma-separated, case-insensitive. The server refuses to start when admins, both lists and the
# access approved on the Access page are all empty, unless ORCH_ALLOW_ANY_GITHUB_USER=true
# (anyone with a GitHub account could then sign in).
# Admins: always allowed; they approve access requests, pre-approve logins and create invite
# links on the Access page (/admin/access). Usually just you:
ORCH_ADMIN_GITHUB_LOGINS=
# Individual GitHub logins that always have access (optional, the Access page is easier):
ORCH_ALLOWED_GITHUB_LOGINS=
# GitHub organizations whose active members may sign in. Checked at login with the user's own
# token, so the GitHub App needs the organization permission "Members: read-only", and the App
# must be installed on (or approved by) the org. Re-checked every few minutes for open sessions.
ORCH_ALLOWED_GITHUB_ORGS=
# GitHub outage: when the org check fails, a user keeps their last known decision for at most this
# many seconds, then is refused (fail closed). Admins and listed or approved logins are unaffected.
ORCH_ACCESS_GRACE_SEC=900
# Explicit opt-out of the allowlist. Only for a server that is not reachable from the internet.
ORCH_ALLOW_ANY_GITHUB_USER=false

# --- GitHub App (see README: Creating the GitHub App) -------------------------------------
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# openssl rand -hex 32   (the same value goes into the App's webhook secret field)
GITHUB_WEBHOOK_SECRET=
# Host path of the App private key PEM, mounted read-only into the server container as
# /run/orch-secrets/github-app.pem. The file must be readable by uid 1000 (the node user).
GITHUB_APP_PRIVATE_KEY_FILE=./secrets/github-app.pem

# --- E-mail notifications (optional) -----------------------------------------------------
# Without SMTP_HOST the e-mail channel is hidden; in-app, Slack, Discord and webhooks still work.
# SMTP_SECURE=true for TLS from the first byte (port 465), false for STARTTLS (port 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Sender, e.g. orch <orch@example.com>. Default: orch@<your domain>.
SMTP_FROM=

# --- Server tuning (optional) ---------------------------------------------------------------
LOG_LEVEL=info

# --- Backups ----------------------------------------------------------------------------
BACKUP_HOUR_UTC=3
BACKUP_RETENTION_DAYS=14
# Also take one dump when the backup container starts.
BACKUP_ON_START=false
