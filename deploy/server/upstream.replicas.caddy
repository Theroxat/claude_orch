# Upstream of every proxied route in routes.caddy with several server replicas
# (compose.replicas.yaml mounts it as /etc/caddy/upstream.caddy).
#
# The upstreams are the A records of the `server` service (one per replica, re-read every 5 s),
# balanced per request. No sticky sessions: every replica answers every route, and an agent's
# WebSocket may land on any replica (the replicas relay messages to each other, see
# docs/installation.md "Running several server instances"). WebSocket upgrades and SSE streams
# (text/event-stream is flushed at once) need nothing more.
dynamic a server 3000 {
	refresh 5s
}
lb_policy least_conn
# A replica that is restarting (connection refused) is skipped: the request is retried on another
# one for up to 5 s, and that replica is avoided for 10 s.
lb_try_duration 5s
lb_try_interval 250ms
fail_duration 10s
