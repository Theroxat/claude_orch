# Shared by Caddyfile.acme and Caddyfile.tunnel: compression, security headers and routes.
# Imported inside a site block. HSTS is not here: acme sends it, tunnel leaves it to Cloudflare.
encode zstd gzip

header {
	X-Content-Type-Options "nosniff"
	Referrer-Policy "strict-origin-when-cross-origin"
	X-Frame-Options "DENY"
	Content-Security-Policy "default-src 'self'; img-src 'self' https://avatars.githubusercontent.com data:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://github.com"
	-Server
}

# GitHub webhook, REST API, GitHub sign-in. Real-time agent link (WebSocket) is proxied as-is.
handle /api/* {
	reverse_proxy server:3000
}

# MCP (Streamable HTTP / SSE): do not buffer the stream.
handle /mcp {
	reverse_proxy server:3000 {
		flush_interval -1
	}
}

# Member machines: /agent/ws (WebSocket), /agent/enroll, /agent/compose.yaml.
handle /agent/* {
	reverse_proxy server:3000
}

handle /install.sh {
	reverse_proxy server:3000
}

handle /healthz {
	reverse_proxy server:3000
}

# The single-page app, built at image build time.
handle {
	root * /srv
	try_files {path} /index.html
	file_server
}
