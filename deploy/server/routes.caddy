# Shared by Caddyfile.acme and Caddyfile.tunnel: compression, security headers and routes.
# Imported inside a site block. HSTS is not here: acme sends it, tunnel leaves it to Cloudflare.
#
# Every proxied route imports upstream.caddy: the single `server` container by default, every
# replica with compose.replicas.yaml (which mounts upstream.replicas.caddy in its place). The
# routes themselves exist once, so the two setups cannot drift apart.
encode zstd gzip

header {
	X-Content-Type-Options "nosniff"
	Referrer-Policy "strict-origin-when-cross-origin"
	X-Frame-Options "DENY"
	Content-Security-Policy "default-src 'self'; img-src 'self' https://avatars.githubusercontent.com data:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://github.com"
	-Server
}

# Operations endpoints are never public: Prometheus scrapes the server's /metrics on the internal
# Docker network (deploy/observability). This stays first, whatever METRICS_ENABLED says.
@internal path /metrics /metrics/* /readyz /api/metrics /api/readyz
handle @internal {
	respond 404
}

# The service worker and the files that describe the app must always be revalidated, otherwise
# a stale /sw.js delays updates. Hashed files under /assets/ stay cacheable.
@revalidate path /sw.js /push-sw.js /manifest.webmanifest /offline.html
header @revalidate Cache-Control "no-cache"

# GitHub webhook, REST API, GitHub sign-in. Real-time agent link (WebSocket) is proxied as-is.
handle /api/* {
	reverse_proxy {
		import upstream.caddy
	}
}

# MCP (Streamable HTTP / SSE): do not buffer the stream.
handle /mcp {
	reverse_proxy {
		import upstream.caddy
		flush_interval -1
	}
}

# Member machines: /agent/ws (WebSocket), /agent/enroll, /agent/compose.yaml.
handle /agent/* {
	reverse_proxy {
		import upstream.caddy
	}
}

# MCP OAuth discovery (RFC 9728 / RFC 8414). The OAuth endpoints live under /api/oauth/*.
handle /.well-known/oauth-* {
	reverse_proxy {
		import upstream.caddy
	}
}

# Invite links (/invite/<token>) are answered by the server, not the single-page app.
handle /invite/* {
	reverse_proxy {
		import upstream.caddy
	}
}

handle /install.sh {
	reverse_proxy {
		import upstream.caddy
	}
}

handle /healthz {
	reverse_proxy {
		import upstream.caddy
	}
}

# The Web Push worker is re-fetched when a browser checks for updates: never serve a stale copy.
@pushsw path /push-sw.js
header @pushsw Cache-Control "no-cache"

# The single-page app, built at image build time.
handle {
	root * /srv
	try_files {path} /index.html
	file_server
}
