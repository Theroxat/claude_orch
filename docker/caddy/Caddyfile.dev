{
	auto_https off
	admin off
}

:80 {
	handle /caddy-health {
		respond "ok" 200
	}
	handle /api/* {
		reverse_proxy server:3000
	}
	# Member machines: enrollment, compose file and the agent WebSocket (upgrade is proxied as-is).
	handle /agent/* {
		reverse_proxy server:3000
	}
	# MCP OAuth discovery (RFC 9728 / RFC 8414). The OAuth endpoints live under /api/oauth/*.
	handle /.well-known/oauth-* {
		reverse_proxy server:3000
	}

	# Invite links are answered by the server, not the web app.
	handle /invite/* {
		reverse_proxy server:3000
	}
	handle /install.sh {
		reverse_proxy server:3000
	}
	handle /healthz {
		reverse_proxy server:3000
	}
	handle {
		reverse_proxy web:5173
	}
}
