# Development placeholders only. ./dev copies this to .env on first run. Never commit .env.

# Host ports (change if they clash with something on your machine)
ORCH_DEV_WEB_PORT=8470
ORCH_DEV_API_PORT=8471

# Postgres (internal to the compose network, not published)
POSTGRES_USER=orch
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=orch
POSTGRES_TEST_DB=orch_test

# Server
LOG_LEVEL=info
ORCH_BASE_URL=http://localhost:8470

# GitHub App (phase B, leave empty for now)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Path (inside the server container) of the GitHub App private key PEM. Never commit the key.
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# 32 random bytes, base64 (openssl rand -base64 32)
ORCH_ENCRYPTION_KEY=

# Dev agent (compose profile `agent`). Paste a one-time enrollment token from My server, or a
# credential (orch_agent_<id>.<secret>). Leave empty otherwise. Never commit real values.
ORCH_DEV_ENROLL_TOKEN=
ORCH_DEV_AGENT_CREDENTIAL=
